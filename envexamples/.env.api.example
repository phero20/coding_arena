# ─── APP CONFIGURATION ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_NAME=coding-arena-api

# ─── URLS ────────────────────────────────────────────────────────────────────
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:3001

# ─── AUTHENTICATION (CLERK) ──────────────────────────────────────────────────
# Found at: https://dashboard.clerk.com/ -> API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_JWT_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=

# ─── DATABASES ────────────────────────────────────────────────────────────────
# PostgreSQL (Drizzle)
DATABASE_URL=postgres://user:pass@localhost:5432/coding_arena

# MongoDB (Operational Data)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=coding_arena

# Redis (Caching & Match Rooms)
REDIS_URL=redis://localhost:6379

# ─── EXECUTION ENGINE (JUDGE0) ────────────────────────────────────────────────
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ─── AI ENGINES ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# ─── EXTERNAL APIS ───────────────────────────────────────────────────────────
# Clist (Contest Sync)
CLIST_USERNAME=
CLIST_API_KEY=

# LeetCode (Problem Import)
LEETCODE_API_URL=https://leetcode.com/graphql

# ─── LOGGING ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
