{
  "name": "slavecode-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "driver",
    "cloud"
  ],
  "scripts": {
    "dev:api": "bun --cwd api run dev",
    "dev:web": "bun --cwd web run dev",
    "test:driver": "bun --cwd driver run test",
    "fetch:exercises": "node --experimental-vm-modules scripts/download-exercise-content.js",
    "fetch:exercises:force": "node --experimental-vm-modules scripts/download-exercise-content.js --force"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "ogl": "^1.0.11"
  }
}